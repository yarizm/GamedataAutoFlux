DASHSCOPE_API_KEY=your_dashscope_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SENSE_API_KEY=your_sensenova_api_key
STEAM_API_KEY=your_steam_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

# LLM 默认 Provider（用于报告生成，可选: qwen / deepseek / sense / local）
LLM_PROVIDER=sense

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autoflux

# Optional
OPENAI_API_KEY=

# ── YouTube Data API ────────────────────────────────
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
# Space-separated collector plugin directories used by Docker builds.
# Example: AUTOFLUX_PLUGINS=youtube steam
AUTOFLUX_PLUGINS=

# Plugin Center mutation policy: auto, mutable, or read_only.
# Multi-worker deployments are read-only even when set to mutable.
AUTOFLUX_PLUGIN_MANAGER_MODE=auto
# Optional repository/deployment root containing config/ and bundled plugin sources.
AUTOFLUX_PROJECT_ROOT=
# Optional comma-separated capability overrides for custom runtime images.
AUTOFLUX_RUNTIME_CAPABILITIES=
AUTOFLUX_DISABLED_RUNTIME_CAPABILITIES=
