{
  "include": ["src", "plugins"],
  "exclude": ["**/__pycache__", "**/node_modules", "src/web/static"],
  "extraPaths": [
    "plugins/dynamic_playwright/src",
    "plugins/gtrends/src",
    "plugins/monitor/src",
    "plugins/official_site/src",
    "plugins/qimai/src",
    "plugins/smart_web/src",
    "plugins/steam/src",
    "plugins/taptap/src",
    "plugins/youtube/src"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "reportMissingImports": "warning",
  "reportArgumentType": "warning",
  "reportCallIssue": "warning",
  "reportGeneralTypeIssues": "warning",
  "reportAttributeAccessIssue": "warning",
  "reportOperatorIssue": "warning"
}
